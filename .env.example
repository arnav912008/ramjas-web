# You normally do not need this file: "npm run setup" creates .env for you.
# On a hosting service, add these as environment variables in its dashboard instead.
NODE_ENV=production
PORT=3000
ADMIN_USER=admin
# Created by "npm run setup" (never type a plain password here)
ADMIN_PASSWORD_HASH=
# Private address of the admin page (not linked on the site). "npm run setup" picks a random one.
# ADMIN_PATH=/manage-k3f9x2qa7d
# Full Google Form link: https://docs.google.com/forms/d/e/.../viewform
GRIEVANCE_FORM_URL=
# Folder for the database and uploaded papers. On a host, point this at the persistent disk, e.g. /var/data
# DATA_DIR=./data
# How many proxies sit in front of the app (1 for Render/Railway/Fly; 2 if you also use Cloudflare)
# TRUST_PROXY=1
